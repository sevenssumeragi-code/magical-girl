{
  "version": 1,
  "title": "魔法少女レニィ☆マギカ (Mahou Shoujo Renny Magica)",
  "note": "グラフィック/BGM担当(Codex)向けの契約ファイル。パスは全て実在すること(現状はプレースホルダ)。本物に差し替えるだけで動作する。詳細な手順は assets/README.md を参照。",
  "namingConvention": {
    "background": "bg_<場所>_<時間帯>",
    "sprite": "sp_<キャラid>_<表情>",
    "cg": "cg_<連番2桁>_<内容>",
    "bgm": "bgm_<用途>[_<連番2桁>]",
    "se": "se_<内容>"
  },
  "spec": {
    "background": {
      "size": "1920x1080",
      "format": "png",
      "note": "1280x720基準で表示。上下左右に若干の余白を持たせる"
    },
    "sprite": {
      "size": "800x1400",
      "format": "png",
      "alpha": true,
      "note": "腰から上。全表情で頭部位置を固定し、差分切替でズレが出ないこと"
    },
    "cg": {
      "size": "1920x1080",
      "format": "png"
    },
    "bgm": {
      "format": "mp3",
      "loop": true,
      "note": "ループポイントをシームレスに。冒頭2秒以内に主題が立ち上がること"
    },
    "se": {
      "format": "ogg",
      "loop": false,
      "note": "0.1〜3.0秒"
    }
  },
  "artDirection": {
    "palette": "全体に彩度低め。灯守形態と翳界のみ彩度を上げてコントラストを作る",
    "keyRule": "レニィとムニは同系統の青を意図的に共有する(物語上の伏線)。ハルのみ全キャラ中で最も彩度が低い(空白の器の表現)",
    "neoRule": "ネオだけは他6人と異なる意匠(異世界の様式)。制服姿を持たない"
  },
